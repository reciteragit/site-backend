DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
# Supabase Connect > Transaction pooler (port 6543). Use the database password,
# URL-encoded; this is not the Supabase anon key. Keep SSL enabled.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
DATABASE_SSL_REQUIRED=true
DJANGO_ALLOWED_HOSTS=backend.example.vercel.app
CSRF_TRUSTED_ORIGINS=https://backend.example.vercel.app
CORS_ALLOWED_ORIGINS=https://frontend.example.vercel.app
