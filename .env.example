DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
# Supabase Connect > Transaction pooler (port 6543). Use the database password,
# URL-encoded; this is not the Supabase anon key. Keep SSL enabled.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Vercel Marketplace may inject POSTGRES_URL instead; it is accepted when
# DATABASE_URL is unset. Do not copy credentials into this example file.
DATABASE_SSL_REQUIRED=true
DJANGO_ALLOWED_HOSTS=backend.example.vercel.app
CSRF_TRUSTED_ORIGINS=https://backend.example.vercel.app
CORS_ALLOWED_ORIGINS=https://frontend.example.vercel.app

# Optional account-owner-authorized automatic donation connection.
STRIPE_SECRET_KEY=
STRIPE_AUTOCONFIGURE=false
STRIPE_FRONTEND_ORIGIN=https://site-pearl-one-38.vercel.app
STRIPE_WEBHOOK_URL=https://site-backend-one.vercel.app/api/payments/stripe/webhook/

# Native accounts / reserved class checkout (teacher approval is still required).
ACADEMY_PAYMENTS_ENABLED=false
# Booking confirmation SMTP credentials; enter real values only in secure settings.
DEFAULT_FROM_EMAIL=info@recitera.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Random secret for the daily Vercel outbox retry cron; never commit a real value.
CRON_SECRET=

# Recommended on Vercel: connect Resend and verify the recitera.com sender domain.
# When present, this selects HTTPS email automatically (unless EMAIL_BACKEND overrides it).
RESEND_API_KEY=
